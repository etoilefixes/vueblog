NODE_ENV=development
PORT=3000
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=10000

DATABASE_URL=postgresql://blog:blog@localhost:5432/blog
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-access-secret
JWT_REFRESH_SECRET=replace-with-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_PUBLIC=blog-public
MINIO_BUCKET_PRIVATE=blog-private
MINIO_TMP_PREFIX=admin/tmp/
MINIO_TMP_EXPIRE_DAYS=3
MEDIA_LOCAL_UPLOAD_DIR=storage/media
MEDIA_LOCAL_MAX_SIZE_BYTES=10485760

CORS_ORIGIN=http://localhost:5173
READINESS_CHECK_TIMEOUT_MS=1000
READINESS_CACHE_TTL_MS=1000

RATE_LIMIT_WRITE_MAX=120
RATE_LIMIT_WRITE_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=8
RATE_LIMIT_LOGIN_WINDOW_MS=60000

ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_DISPLAY_NAME=系统管理员
ADMIN_BOOTSTRAP_PASSWORD=change-me-in-local-env
ADMIN_BOOTSTRAP_ROLES=admin
ADMIN_BOOTSTRAP_PERMISSIONS=*,dashboard:read,site:read,site:write,audit:read,publish:manage,theme:write,media:write,post:read,post:write,comment:moderate,access:write
ADMIN_AUDIT_LOG_LIMIT=500
